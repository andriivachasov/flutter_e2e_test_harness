# Machine-local harness config — COPY, DO NOT EDIT THIS FILE IN PLACE.
#
#     cp e2e.local.yaml.template e2e.local.yaml
#
# `e2e.local.yaml` is gitignored and never enters the repository. It is
# deep-merged over `e2e.yaml`, so set only the keys you want to change.
# Precedence, lowest first:
#
#     e2e.yaml  <  e2e.local.yaml  <  E2E_* environment variables
#
# `e2e doctor` prints which sources were used and validates the result.
# Secrets are redacted everywhere the harness prints config (doctor, logs,
# summary.json) — the values below never reach an artifact.

# ---------------------------------------------------------------------------
# Firebase (D2/D6)
# ---------------------------------------------------------------------------
# The default in e2e.yaml is emulator mode with a `demo-` project id, which
# needs NO credentials — a cold checkout runs the whole suite without this
# file existing. You only need the block below to run against the dedicated
# test-only Firebase project (D6).
#
# Two values, both public client identifiers (not secrets) but project-
# specific — no admin credentials of any kind are needed (D23):
#
#   project_id   the dedicated test-only project (D6)
#   api_key      its Web API key: Firebase console > Project settings >
#                General > "Web API Key". The app signs users up/in with it.
#                Email/Password must be enabled under Authentication >
#                Sign-in method (e2e doctor probes both).
#
# `mode` selects which project is live. Leaving it `emulator` while the real
# values sit here is fine and is the recommended day-to-day setup: flip with
# `E2E_FIREBASE_MODE=real e2e run ...`
#
# firebase:
#   mode: real                     # emulator | real | none
#   project_id: your-test-project  # must NOT start with "demo-"
#   api_key: "AIza..."

# ---------------------------------------------------------------------------
# User pool (R10, D23)
# ---------------------------------------------------------------------------
# Accounts are <scope>-<role>@<email_domain>, registered by the app on first
# use with ONE shared password. Set your own for a real project:
#
# provisioner:
#   pool_password: choose-something
#   email_domain: e2e.example.com
#
# Env equivalents: E2E_POOL_PASSWORD, E2E_POOL_EMAIL_DOMAIN. Parallel runs
# against one real project share the pool — one run per project at a time.

# ---------------------------------------------------------------------------
# Shared secret for the /test/* surface (optional, issue #7)
# ---------------------------------------------------------------------------
# The test-only endpoints delete arbitrary user data and must work before an
# account exists, so they cannot be authenticated: E2E_TEST_MODE=1 only
# ENABLES them. The recommended lock is to bind the test backend to loopback
# and reject non-loopback callers (docs/playbook/03-backend-contract.md
# §3.2) — no secret to leak or rotate.
#
# If your backend cannot bind to loopback (a container, a shared host), or
# you want a second factor anyway, the orchestrator can send a header with
# every /test/* request; the backend rejects requests without it. Unset by
# default. The VALUE IS A SECRET — that is why it lives here — and the
# harness redacts it from summary.json and every log (only the header name
# is ever printed).
#
# backend:
#   test_header:
#     name: X-E2E-Test-Secret
#     value: a-long-random-string
#
# Several headers instead of one: list them as `<name>: <value>` directly
# under `test_header`. Env equivalents (CI, nothing on disk):
# E2E_BACKEND_TEST_HEADER, E2E_BACKEND_TEST_HEADER_VALUE.

# ---------------------------------------------------------------------------
# Machine-specific device overrides (optional)
# ---------------------------------------------------------------------------
# Handy when your simulator/AVD names differ from the committed defaults.
#
# devices:
#   ios:
#     name: "iPhone 16 Pro"
#   android:
#     avd: my_local_avd
#     gpu: swangle                 # use a software renderer on a GPU-less box
